
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ABC College</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
            color: #333;
            line-height: 1.6;
        }

        header {
            background-color: #123c69;
            color: white;
            padding: 20px;
            text-align: center;
        }

        header h1 {
            font-size: 32px;
        }

        nav {
            background-color: #0b2545;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ffd166;
        }

        .banner {
            background: linear-gradient(120deg, #123c69, #2878b5);
            color: white;
            text-align: center;
            padding: 80px 20px;
        }

        .banner h2 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .button {
            display: inline-block;
            background-color: #ffd166;
            color: #123c69;
            padding: 12px 25px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }

        .button:hover {
            background-color: white;
        }

        section {
            padding: 45px 8%;
            text-align: center;
        }

        section h2 {
            color: #123c69;
            margin-bottom: 25px;
            font-size: 30px;
        }

        .about p {
            max-width: 850px;
            margin: auto;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background-color: white;
            padding: 25px 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h3 {
            color: #2878b5;
            margin-bottom: 10px;
        }

        .icon {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .admissions {
            background-color: #e5effa;
        }

        .admissions ol {
            display: inline-block;
            text-align: left;
            margin-bottom: 25px;
        }

        .contact {
            background-color: white;
        }

        .contact p {
            margin: 8px;
        }

        footer {
            background-color: #0b2545;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 25px;
            }

            nav a {
                display: inline-block;
                margin: 6px;
                font-size: 14px;
            }

            .banner {
                padding: 55px 15px;
            }

            .banner h2 {
                font-size: 28px;
            }

            section {
                padding: 35px 5%;
            }
        }
    </style>
</head>

